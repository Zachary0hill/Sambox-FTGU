NEXT_PUBLIC_SUPABASE_URL=https://mupwdvcpymlrnrsnmqfo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Supabase secret key: mints invite links, reads integration keys from Vault, writes synced data. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Server only. Resend key for invite and notification emails, and the verified sender.
RESEND_API_KEY=
EMAIL_FROM=YouTube Studio <invites@your-verified-domain.com>
# Optional. Public URL used in invite links (defaults to the request origin). Must be a public https URL for monday webhooks.
APP_BASE_URL=
# Server only. Lets a scheduler (Vercel Cron, pg_cron) call POST /api/integrations/<provider>/sync with
# `Authorization: Bearer <CRON_SECRET>` to sync every workspace that has that provider connected, and
# /api/notifications/send (every 15 minutes) to send notification emails and deadline reminders, and
# /api/automations/run (every 5 minutes) to run automations and their retries.
CRON_SECRET=
# Optional. Signs monday.com webhook URLs. Falls back to SUPABASE_SECRET_KEY, so set it if you ever rotate that key.
MONDAY_WEBHOOK_SECRET=
